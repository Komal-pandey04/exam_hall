{
  "name": "examhall-backend",
  "version": "1.0.0",
  "description": "REST API for the ExamHall online test platform (Express + SQLite)",
  "main": "src/server.js",
  "type": "module",
  "engines": { "node": ">=18.18" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/db/seed.js",
    "seed:reset": "node src/db/seed.js --reset",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0"
  }
}
