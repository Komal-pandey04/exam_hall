# Server port (Render injects PORT automatically)
PORT=5000
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173
# SQLite file location (used if TURSO_DATABASE_URL is not set)
DB_PATH=./data/examhall.db
# Turso Database URL and Auth Token (optional - if set, connects to Turso cloud database)
# TURSO_DATABASE_URL=libsql://examhall-youruser.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# Secret used by the admin panel (sent as the x-admin-key header). CHANGE THIS.
ADMIN_KEY=change-me-to-a-long-random-string
# Days a login stays valid (default 30)
SESSION_DAYS=30
# Mock test duration in minutes (default 120). Applied when mock tests are first created.
MOCK_DURATION_MINUTES=120
